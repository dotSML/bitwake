worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr notice;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Keep request arguments out of logs: qBittorrent GET parameters include
    # host paths, torrent hashes, RSS rule names, and other private metadata.
    log_format main '$remote_addr - $remote_user [$time_local] '
                    '"$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /dev/stdout main;

    client_body_temp_path /tmp/client_temp 1 2;
    proxy_temp_path /tmp/proxy_temp 1 2;
    fastcgi_temp_path /tmp/fastcgi_temp 1 2;
    uwsgi_temp_path /tmp/uwsgi_temp 1 2;
    scgi_temp_path /tmp/scgi_temp 1 2;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/javascript application/json application/manifest+json application/xml image/svg+xml text/css text/plain text/xml;

    map $http_x_forwarded_proto $bitwake_forwarded_proto {
        default $scheme;
        http http;
        https https;
    }

    server {
        listen ${LISTEN_PORT};
        listen [::]:${LISTEN_PORT};
        server_name _;

        root /usr/share/nginx/html;
        index index.html;
        client_max_body_size ${MAX_UPLOAD_SIZE};

        include /etc/nginx/bitwake-security-headers.conf;

        location = /healthz {
            access_log off;
            default_type application/json;
            return 200 '{"status":"ok"}\n';
        }

        location = /readyz {
            access_log off;
            default_type application/json;
            return 200 '{"status":"ready"}\n';
        }

        location = /api {
            default_type text/plain;
            return 404 'Not Found\n';
        }

        location = /_bitwake/runtime-config.json {
            access_log off;
            alias /tmp/bitwake-runtime-config.json;
            default_type application/json;
            etag off;
            add_header Cache-Control "no-store" always;
            include /etc/nginx/bitwake-security-headers.conf;
        }

        # Deprecated compatibility endpoint retained for in-place upgrades.
        location = /_neotorrent/runtime-config.json {
            access_log off;
            alias /tmp/bitwake-runtime-config.json;
            default_type application/json;
            etag off;
            add_header Cache-Control "no-store" always;
            include /etc/nginx/bitwake-security-headers.conf;
        }

        location ^~ /_bitwake/ {
            default_type text/plain;
            return 404 'Not Found\n';
        }

        location ^~ /_neotorrent/ {
            default_type text/plain;
            return 404 'Not Found\n';
        }

        location ^~ /api/ {
            proxy_pass ${QBITTORRENT_API_URL};
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            # qBittorrent validates Host ports against its internal listen port.
            # Preserve the external authority (including its port) separately in
            # X-Forwarded-Host for trusted reverse-proxy origin validation.
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            # Do not append a caller-supplied X-Forwarded-For value. Operators
            # that need the address before a trusted ingress should configure
            # Nginx real_ip trust explicitly instead of accepting it from all
            # clients.
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $bitwake_forwarded_proto;

            proxy_ssl_server_name on;
            proxy_ssl_verify ${PROXY_SSL_VERIFY};
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

            proxy_connect_timeout ${PROXY_CONNECT_TIMEOUT};
            proxy_read_timeout ${PROXY_READ_TIMEOUT};
            proxy_send_timeout ${PROXY_SEND_TIMEOUT};
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_max_temp_file_size 0;

            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            proxy_hide_header X-Accel-Expires;
            add_header Cache-Control "no-store" always;
            include /etc/nginx/bitwake-security-headers.conf;
        }

        location = /index.html {
            expires -1;
            try_files $uri =404;
        }

        location = /sw.js {
            expires -1;
            try_files $uri =404;
        }

        location = /manifest.webmanifest {
            expires -1;
            try_files $uri =404;
        }

        location ^~ /icons/ {
            expires -1;
            try_files $uri =404;
        }

        location ^~ /assets/ {
            expires 1y;
            add_header Cache-Control "public, max-age=31536000, immutable";
            include /etc/nginx/bitwake-security-headers.conf;
            try_files $uri =404;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
